# App
ENVIRONMENT=development
ENABLE_SWAGGER=true
ENABLE_METRICS=false
PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
BASE_URL=http://localhost:8080
LOG_LEVEL=INFO
DOMAIN=localhost

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth_go?sslmode=disable

# Authentication rate limiting
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_KEY=change-me-rate-limit-key
RATE_LIMIT_MAX_MEMORY_KEYS=10000
RATE_LIMIT_ALLOW_MEMORY_PRODUCTION=false
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
TRUSTED_PROXIES=
RATE_LIMIT_LOGIN_IP=30/1m
RATE_LIMIT_LOGIN_ACCOUNT=5/15m
RATE_LIMIT_REGISTER_IP=5/1h
RATE_LIMIT_REGISTER_EMAIL=5/1h
RATE_LIMIT_RECOVERY_IP=10/1h
RATE_LIMIT_RECOVERY_EMAIL=3/1h
RATE_LIMIT_RECOVERY_TOKEN=3/1h
RATE_LIMIT_REFRESH_IP=30/1m
RATE_LIMIT_VERIFY_IP=10/1h
RATE_LIMIT_VERIFY_EMAIL=3/1h
RATE_LIMIT_OAUTH_IP=10/1m

# Auth
JWT_ACCESS_SECRET=change-me
REFRESH_TOKEN_HASH_KEY=change-me-too
SESSION_SECRET=change-me

# OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email
EMAIL=
PASSWORD=
